# Public site URL used for canonical links, sitemap and JSON-LD (e.g. https://streller.com)
SITE_URL=

# Strong random secret for hashing contact rate-limit IP addresses
SESSION_SECRET=

# Persistent storage directory outside the deployment folder in production
DATA_DIR=

# Where contact-form notifications are sent (optional — inquiries are always saved to SQLite)
CONTACT_TO_EMAIL=

# Resend API key for email notifications (optional)
RESEND_API_KEY=
